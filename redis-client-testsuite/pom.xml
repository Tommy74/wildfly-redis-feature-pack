<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.wildfly.redis</groupId>
        <artifactId>wildfly-redis-feature-pack-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>redis-client-testsuite</artifactId>
    <name>Redis Client Feature Pack - Test Suite</name>

    <properties>
        <jboss.home>${project.build.directory}/wildfly</jboss.home>
    </properties>

    <dependencies>
        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Arquillian -->
        <dependency>
            <groupId>org.wildfly.arquillian</groupId>
            <artifactId>wildfly-arquillian-container-managed</artifactId>
            <version>${version.org.wildfly.arquillian}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.arquillian.junit5</groupId>
            <artifactId>arquillian-junit5-container</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.redis</groupId>
            <artifactId>testcontainers-redis</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Application dependencies (provided at runtime by server) -->
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>redis-client-injection</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- HTTP client for testing -->
        <dependency>
            <groupId>org.jboss.resteasy</groupId>
            <artifactId>resteasy-client</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Provision WildFly servers with Redis support -->
            <plugin>
                <groupId>org.wildfly.plugins</groupId>
                <artifactId>wildfly-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>provision-server</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>package</goal>
                        </goals>
                        <configuration>
                            <skipDeployment>true</skipDeployment>
                            <provisioning-dir>${jboss.home}</provisioning-dir>
                            <feature-packs>
                                <feature-pack>
                                    <groupId>org.wildfly</groupId>
                                    <artifactId>wildfly-galleon-pack</artifactId>
                                    <version>${version.org.wildfly}</version>
                                </feature-pack>
                                <feature-pack>
                                    <groupId>${project.groupId}</groupId>
                                    <artifactId>redis-client-feature-pack</artifactId>
                                    <version>${project.version}</version>
                                </feature-pack>
                            </feature-packs>
                            <layers>
                                <layer>jaxrs-server</layer>
                                <layer>redis-client</layer>
                            </layers>
                            <galleon-options>
                                <jboss-fork-embedded>true</jboss-fork-embedded>
                            </galleon-options>
                            <packagingScripts>
                                <packaging-script>
                                    <commands>
                                        <!-- Default connection using cluster-nodes -->
                                        <command>/subsystem=redis-client/redis-connection=default:add(cluster-nodes=${redis.cluster.nodes:127.0.0.1:6379})</command>
                                        <!-- Connection using outbound socket binding -->
                                        <command>/socket-binding-group=standard-sockets/remote-destination-outbound-socket-binding=redis-test-server:add(host=${redis.socket.host:127.0.0.1},port=${redis.socket.port:6379})</command>
                                        <command>/subsystem=redis-client/redis-connection=socket-binding-conn:add(outbound-socket-bindings=[redis-test-server])</command>
                                    </commands>
                                </packaging-script>
                            </packagingScripts>
                        </configuration>
                    </execution>
                    <!-- Provision session clustering servers for distributable web tests -->
                    <execution>
                        <id>provision-session-server-1</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>package</goal>
                        </goals>
                        <configuration>
                            <skipDeployment>true</skipDeployment>
                            <provisioning-dir>${project.build.directory}/wildfly-session-1</provisioning-dir>
                            <stability>community</stability>
                            <feature-packs>
                                <feature-pack>
                                    <groupId>org.wildfly</groupId>
                                    <artifactId>wildfly-galleon-pack</artifactId>
                                    <version>${version.org.wildfly}</version>
                                </feature-pack>
                                <feature-pack>
                                    <groupId>${project.groupId}</groupId>
                                    <artifactId>redis-client-feature-pack</artifactId>
                                    <version>${project.version}</version>
                                </feature-pack>
                            </feature-packs>
                            <layers>
                                <layer>jaxrs-server</layer>
                                <layer>redis-client</layer>
                                <layer>redis-store</layer>
                            </layers>
                            <galleon-options>
                                <jboss-fork-embedded>true</jboss-fork-embedded>
                            </galleon-options>
                            <packagingScripts>
                                <packaging-script>
                                    <commands>
                                        <command>/system-property=jboss.node.name:add(value=session-node-1)</command>
                                        <command>/subsystem=undertow:write-attribute(name=instance-id,value="session-node-1")</command>
                                        <command>/subsystem=transactions:write-attribute(name=node-identifier,value="session-node-1")</command>
                                        <command>/socket-binding-group=standard-sockets:write-attribute(name=port-offset,value="$\{jboss.socket.binding.port-offset:400\}")</command>
                                        <command>/subsystem=redis-client/redis-connection=default:add(cluster-nodes=${redis.cluster.nodes:127.0.0.1:6379})</command>
                                        <command>/subsystem=infinispan/cache-container=web/distributed-cache=dist:write-attribute(name=modules,value=[org.wildfly.redis.store])</command>
                                        <command>/subsystem=infinispan/cache-container=web/distributed-cache=dist/store=file:remove()</command>
                                        <command>/subsystem=infinispan/cache-container=web/distributed-cache=dist/store=custom:add(class=org.wildfly.redis.store.RedisStoreConfigurationBuilder, passivation=false, preload=false, purge=false, shared=true, properties={connection=default})</command>
                                    </commands>
                                </packaging-script>
                            </packagingScripts>
                        </configuration>
                    </execution>
                    <execution>
                        <id>provision-session-server-2</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>package</goal>
                        </goals>
                        <configuration>
                            <skipDeployment>true</skipDeployment>
                            <provisioning-dir>${project.build.directory}/wildfly-session-2</provisioning-dir>
                            <stability>community</stability>
                            <feature-packs>
                                <feature-pack>
                                    <groupId>org.wildfly</groupId>
                                    <artifactId>wildfly-galleon-pack</artifactId>
                                    <version>${version.org.wildfly}</version>
                                </feature-pack>
                                <feature-pack>
                                    <groupId>${project.groupId}</groupId>
                                    <artifactId>redis-client-feature-pack</artifactId>
                                    <version>${project.version}</version>
                                </feature-pack>
                            </feature-packs>
                            <layers>
                                <layer>jaxrs-server</layer>
                                <layer>redis-client</layer>
                                <layer>redis-store</layer>
                            </layers>
                            <galleon-options>
                                <jboss-fork-embedded>true</jboss-fork-embedded>
                            </galleon-options>
                            <packagingScripts>
                                <packaging-script>
                                    <commands>
                                        <command>/system-property=jboss.node.name:add(value=session-node-2)</command>
                                        <command>/subsystem=undertow:write-attribute(name=instance-id,value="session-node-2")</command>
                                        <command>/subsystem=transactions:write-attribute(name=node-identifier,value="session-node-2")</command>
                                        <command>/socket-binding-group=standard-sockets:write-attribute(name=port-offset,value="$\{jboss.socket.binding.port-offset:500\}")</command>
                                        <command>/subsystem=redis-client/redis-connection=default:add(cluster-nodes=${redis.cluster.nodes:127.0.0.1:6379})</command>
                                        <command>/subsystem=infinispan/cache-container=web/distributed-cache=dist:write-attribute(name=modules,value=[org.wildfly.redis.store])</command>
                                        <command>/subsystem=infinispan/cache-container=web/distributed-cache=dist/store=file:remove()</command>
                                        <command>/subsystem=infinispan/cache-container=web/distributed-cache=dist/store=custom:add(class=org.wildfly.redis.store.RedisStoreConfigurationBuilder, passivation=false, preload=false, purge=false, shared=true, properties={connection=default})</command>
                                    </commands>
                                </packaging-script>
                            </packagingScripts>
                        </configuration>
                    </execution>
                    <!-- Provision a second server with redis-store layer for custom store tests -->
                    <execution>
                        <id>provision-store-server</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>package</goal>
                        </goals>
                        <configuration>
                            <skipDeployment>true</skipDeployment>
                            <provisioning-dir>${project.build.directory}/wildfly-store</provisioning-dir>
                            <feature-packs>
                                <feature-pack>
                                    <groupId>org.wildfly</groupId>
                                    <artifactId>wildfly-galleon-pack</artifactId>
                                    <version>${version.org.wildfly}</version>
                                </feature-pack>
                                <feature-pack>
                                    <groupId>${project.groupId}</groupId>
                                    <artifactId>redis-client-feature-pack</artifactId>
                                    <version>${project.version}</version>
                                </feature-pack>
                            </feature-packs>
                            <layers>
                                <layer>jaxrs-server</layer>
                                <layer>redis-client</layer>
                                <layer>redis-store</layer>
                            </layers>
                            <galleon-options>
                                <jboss-fork-embedded>true</jboss-fork-embedded>
                            </galleon-options>
                            <packagingScripts>
                                <packaging-script>
                                    <commands>
                                        <command>/subsystem=redis-client/redis-connection=default:add(cluster-nodes=${redis.cluster.nodes:127.0.0.1:6379})</command>
                                    </commands>
                                </packaging-script>
                            </packagingScripts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                        <configuration>
                            <systemPropertyVariables>
                                <jboss.home>${jboss.home}</jboss.home>
                                <jboss.home.store>${project.build.directory}/wildfly-store</jboss.home.store>
                                <jboss.home.session1>${project.build.directory}/wildfly-session-1</jboss.home.session1>
                                <jboss.home.session2>${project.build.directory}/wildfly-session-2</jboss.home.session2>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
