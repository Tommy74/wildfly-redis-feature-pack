<?xml version="1.0" encoding="UTF-8"?>
<arquillian xmlns="http://jboss.org/schema/arquillian"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://jboss.org/schema/arquillian http://jboss.org/schema/arquillian/arquillian_1_0.xsd">
    <container qualifier="wildfly-managed" default="true">
        <configuration>
            <property name="jbossHome">${jboss.home}</property>
            <property name="startupTimeoutInSeconds">120</property>
            <property name="managementPort">10090</property>
            <property name="jbossArguments">--stability=community</property>
            <property name="javaVmArguments">-Xmx512m -Djboss.socket.binding.port-offset=100 -Dredis.cluster.nodes=${redis.cluster.nodes:127.0.0.1:6379} -Dredis.socket.host=${redis.socket.host:127.0.0.1} -Dredis.socket.port=${redis.socket.port:6379}</property>
        </configuration>
    </container>
</arquillian>
